# ---- Serveur ----
PORT=8787
# Origines autorisees (CORS), separees par des virgules. "*" = tout (dev uniquement).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Nombre max de requetes /ai/chat par utilisateur et par minute
RATE_LIMIT_PER_MIN=20

# ---- API Magileads ----
MAGILEADS_API_BASE=https://app.api-magileads.net

# ---- Fournisseur du modele (compatible OpenAI, avec function calling) ----
AI_API_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Paliers proposes a l'utilisateur : Gratuit / Simple / Complexe / Perso.
# L'utilisateur ne voit JAMAIS ces identifiants (sauf "Perso." ou c'est lui qui saisit).
#
# "Gratuit" : modeles :free essayes DANS L'ORDRE. Les modeles gratuits d'OpenRouter
# disparaissent ou saturent (404 / 429) -> bascule automatique sur le suivant.
# Ils doivent supporter le function calling.
AI_MODEL_FREE=z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
# "Simple" (palier par defaut)
AI_MODEL=z-ai/glm-5.2
# "Complexe" (si vide -> identique a Simple)
AI_MODEL_COMPLEX=deepseek/deepseek-v4-pro
# "Perso." : autorise le client a fournir l'id du modele (ex. stealth/ox-alpha).
# Mettre "false" pour desactiver ce palier.
ALLOW_CUSTOM_MODEL=true
